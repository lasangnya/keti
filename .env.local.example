# keti — local Firebase credentials (reference copy)
#
# Copy this file to .env.local and fill in the real values from the Firebase
# console (Project settings → General → Your apps). .env.local is gitignored
# and must NEVER be committed — the repo is public.
#
# The app itself does NOT read .env files. These values are consumed via:
#   1. lib/firebase_options.dart        (copy from lib/firebase_options.dart.example)
#   2. macos/Runner/GoogleService-Info.plist
#      (copy from macos/Runner/GoogleService-Info.plist.example)
# Both target files are also gitignored. Keep .env.local as the single
# reference record so re-creating them is a copy-paste job.

KETI_FIREBASE_PROJECT_ID=REPLACE_ME_PROJECT_ID
KETI_FIREBASE_SENDER_ID=REPLACE_ME_SENDER_ID
KETI_FIREBASE_STORAGE_BUCKET=REPLACE_ME_STORAGE_BUCKET

# macOS app (used by firebase_options.dart + GoogleService-Info.plist)
KETI_FIREBASE_MACOS_API_KEY=REPLACE_ME_MACOS_API_KEY
KETI_FIREBASE_MACOS_APP_ID=REPLACE_ME_MACOS_APP_ID

# Windows app (used by firebase_options.dart only)
KETI_FIREBASE_WINDOWS_API_KEY=REPLACE_ME_WINDOWS_API_KEY
KETI_FIREBASE_WINDOWS_APP_ID=REPLACE_ME_WINDOWS_APP_ID
KETI_FIREBASE_WINDOWS_MEASUREMENT_ID=REPLACE_ME_MEASUREMENT_ID
