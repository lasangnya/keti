<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for macos/Runner/GoogleService-Info.plist — copy this file to
     macos/Runner/GoogleService-Info.plist and replace every REPLACE_ME value
     with the real one from the Firebase console (or download the real plist
     from Project settings → Your apps → macOS app).
     The real plist is gitignored and must NEVER be committed. -->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_ME_MACOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_ME_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>app.keti.keti</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_ME_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_ME_STORAGE_BUCKET</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_ME_MACOS_APP_ID</string>
</dict>
</plist>
